---
// /profile/<uid> (bundle `Jte` -> `QP` + `sq`, rules of profileRender): the creator's public sketches, filtered,
// sorted (newest first, as live) and paged in the URL; canonical to the unfiltered profile. 404 for an unknown
// id with no public sketches, noindex for a profile with none. Cached with profile:<uid> + related:<card>.
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import CardIcons from '../../components/CardIcons.astro';
import FilterForm from '../../components/FilterForm.astro';
import Pagination from '../../components/Pagination.astro';
import { getDoc, query } from '../../lib/firestore.ts';
import { ORIGIN, TAG_LABELS, canonicalPath, isDocId, jsonLd, previewUrl, reference, type Sketch } from '../../lib/sketch.ts';
import { applyFilters, availableFilters, filterQuery, paginate, parseFilters } from '../../lib/listing.ts';

const uid = Astro.params.uid ?? '';
if (!isDocId(uid)) return Astro.rewrite('/404');

let user: Record<string, any> | null = null;
let all: Sketch[] = [];
let failed = false;
try {
  [user, all] = await Promise.all([
    getDoc('users', uid),
    // No composite index on userId + isPublic + createdAt: unordered, sorted below (as the bundle's `F8`).
    query('sketches', [['userId', uid], ['isPublic', true]], 1000, { ordered: false }) as Promise<Sketch[]>,
  ]);
} catch (e) {
  console.error('[profile]', uid, e);
  failed = true;
}
all = all.filter((s) => !s.isBookmark);
if (!failed && !user && all.length === 0) return Astro.rewrite('/404');

const name = (user?.displayName as string) || 'Bible Sketch User';
const photo = (user?.photoURL as string) || '';
const f = parseFilters(Astro.url.searchParams, { sort: 'newest', tags: Object.keys(TAG_LABELS) });
const matches = applyFilters(all, f);
const { items, page, pages } = paginate(matches, f.page);
const path = `/profile/${encodeURIComponent(uid)}`;
const canonical = `${ORIGIN}${path}`;

// Filter options come from what this creator has published (bundle behaviour).
const available = availableFilters(all, Object.keys(TAG_LABELS));

if (failed) {
  Astro.cache.set(false);
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '120');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  // All profiles are unlisted: collection pages do their job for search (docs/seo-plan.md stage 2).
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
  Astro.cache.set({ maxAge: 3600, swr: 86400, tags: [`profile:${uid}`, ...items.map((s) => `related:${s.id}`)] });
  Astro.response.headers.set('Cache-Control', 'public, max-age=300');
}

const title = `${name}'s Bible Coloring Pages | Bible Sketch Gallery`;
const description = `Browse ${name}'s collection of Bible coloring pages. Printable Christian coloring sheets created with Bible Sketch.`;
const image = photo || `${ORIGIN}/logo.png`;
const schema = jsonLd({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': canonical,
  url: canonical,
  mainEntity: {
    '@type': 'Person',
    name,
    image,
    url: canonical,
    interactionStatistic: { '@type': 'InteractionCounter', interactionType: 'https://schema.org/WriteAction', userInteractionCount: all.length },
    hasPart: {
      '@type': 'ItemList',
      itemListElement: items.map((s, i) => ({
        '@type': 'ListItem',
        position: (page - 1) * 24 + i + 1,
        item: {
          '@type': 'VisualArtwork',
          name: s.promptData ? `${reference(s.promptData)} Coloring Page` : 'Bible Sketch',
          image: previewUrl(s),
          url: `${ORIGIN}${canonicalPath(s)}`,
          datePublished: s.createdAt,
        },
      })),
    },
  },
});
---
<Base title={title} description={description} canonical={canonical} ogType="profile" image={image} imageAlt={name}
  twitterCard="summary" schemas={[schema]}>
  <Fragment slot="head"><meta property="profile:username" content={name} /></Fragment>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <a href="/gallery" class="inline-flex items-center gap-2 text-gray-500 hover:text-[#7C3AED] font-bold mb-6 transition-colors group">
      <span class="p-2 bg-white rounded-full shadow-sm group-hover:shadow-md border border-gray-100 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
      </span>
      <span>Back to Gallery</span>
    </a>
    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm mb-8 flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
      <div class="w-24 h-24 rounded-full bg-purple-100 flex items-center justify-center text-[#7C3AED] overflow-hidden border-4 border-white shadow-md shrink-0">
        {photo ? <img src={photo} alt="" width="96" height="96" class="w-full h-full object-cover" referrerpolicy="no-referrer" />
          : <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>}
      </div>
      <div>
        <h1 class="font-display text-3xl md:text-4xl font-bold text-gray-800 mb-2">{name}'s Gallery</h1>
        <p class="text-gray-500">Viewing public sketches from this creator.</p>
      </div>
    </div>

    {all.length > 0 && <FilterForm filters={f} action={path} defaultSort="newest" showTag available={available} />}

    {failed ? (
      <p class="text-center py-16 text-gray-500">This gallery is temporarily unavailable. Please try again in a couple of minutes.</p>
    ) : items.length === 0 ? (
      <div class="text-center py-16">
        <h2 class="font-display text-2xl font-bold text-gray-800 mb-2">{f.book ? `No sketches found for ${f.book}` : 'No images found'}</h2>
        <p class="text-gray-500">This user hasn't shared any sketches publicly yet.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <CardIcons />
        {items.map((s) => <ListingCard sketch={s} author={name} />)}
      </div>
    )}
    <Pagination page={page} pages={pages} href={(n) => path + filterQuery(f, 'newest', n)} />
  </div>
</Base>
