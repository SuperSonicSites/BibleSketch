---
// /coloring-pages (docs/seo-plan.md stage 9): every Bible story with owner pages, in Bible order, then the verses
// with enough pages for their own page. Unlinked until the owner reviews it. Cached with `stories`.
import Base from '../../layouts/Base.astro';
import { ORG_REF, ORIGIN, type Sketch, heading, jsonLd, reference, slugOf, thumbUrl } from '../../lib/sketch.ts';
import { STORIES, VERSE_MIN, allOwnerPages, byBibleOrder, pagesOfStory, storyOf } from '../../lib/stories.ts';

let all: Sketch[] = [];
let failed = false;
try {
  all = await allOwnerPages();
} catch (e) {
  console.error('[coloring-pages]', e);
  failed = true;
}
const stories = STORIES.map((st) => ({ st, pages: pagesOfStory(st, all) })).filter((x) => x.pages.length);
const verses = new Map<string, Sketch[]>();
for (const s of [...all].sort(byBibleOrder)) verses.set(slugOf(s), [...(verses.get(slugOf(s)) ?? []), s]);
// Memory verses: popular passages that belong to no story (story passages are on their story's page).
const popular = [...verses.entries()].filter(([, v]) => v.length >= VERSE_MIN && !storyOf(v[0]));

// One look for the story covers: the toddler Sunday School page, else the young-child one. Stories without either
// are listed as text links below the grid instead of breaking its style (docs/seo-plan.md stage 9).
const cover = (pages: Sketch[], age: string) =>
  pages.find((s) => s.type !== 'verse' && s.promptData?.art_style === 'Sunday School' && s.promptData?.age_group === age);
const covered = stories.map((x) => ({ ...x, cover: cover(x.pages, 'Toddler') ?? cover(x.pages, 'Young Child') })).filter((x) => x.cover);
const uncovered = stories.filter((x) => !covered.some((c) => c.st.id === x.st.id));

if (failed) {
  Astro.cache.set(false);
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '120');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.cache.set({ maxAge: 3600, swr: 86400, tags: ['stories'] });
  Astro.response.headers.set('Cache-Control', 'public, max-age=300');
}

const url = `${ORIGIN}/coloring-pages`;
const h1 = 'Bible Coloring Pages by Story';
const title = `${h1} | Printable Pages in Bible Order | Bible Sketch`;
const span = stories.length ? ` from ${stories[0].st.name} to ${stories.at(-1)!.st.name.replace(/^The /, 'the ')}` : '';
const description = `Printable Bible coloring pages for ${stories.length} Bible stories${span}, in Bible order. For Sunday school, homeschool and family devotions.`;
const schemas = [
  jsonLd({
    '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url, url, name: h1, description,
    isPartOf: { '@type': 'WebSite', '@id': `${ORIGIN}/#website`, url: `${ORIGIN}/`, name: 'Bible Sketch' }, publisher: ORG_REF,
    mainEntity: {
      '@type': 'ItemList', itemListOrder: 'https://schema.org/ItemListOrderAscending', numberOfItems: stories.length,
      itemListElement: stories.map(({ st }, i) => ({ '@type': 'ListItem', position: i + 1, url: `${url}/${st.id}`, name: `${st.name.replace(/^The /, '')} Coloring Pages` })),
    },
  }),
];
---
<Base title={title} description={description} canonical={url} ogType="website" image={`${ORIGIN}/logo.png`}
  imageAlt="Bible Sketch Logo" twitterCard="summary" schemas={schemas}>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="bg-gradient-to-br from-purple-50 to-amber-50 rounded-3xl p-8 border border-purple-100 mb-10">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-800 mb-3">{h1}</h1>
      <p class="text-gray-600 text-base leading-relaxed">{description}</p>
    </div>

    {failed ? (
      <p class="text-center py-16 text-gray-500">These coloring pages are temporarily unavailable. Please try again in a couple of minutes.</p>
    ) : (
      <>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {covered.map(({ st, pages, cover }) => (
            <a href={`/coloring-pages/${st.id}`} class="group bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 overflow-hidden flex flex-col">
              <div class="relative overflow-hidden bg-white aspect-[3/4]">
                <img src={thumbUrl(cover!)} alt={`${st.name} coloring page (${reference(cover!.promptData!)})`} width="400" height="533"
                  loading="lazy" decoding="async" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="px-3 py-3 border-t border-gray-50">
                <h2 class="font-bold text-gray-800">{st.name.replace(/^The /, '')}</h2>
                <p class="text-xs text-gray-500 mt-1">{pages.length} coloring page{pages.length === 1 ? '' : 's'}</p>
              </div>
            </a>
          ))}
        </div>
        {uncovered.length > 0 && (
          <p class="mt-6 text-sm text-gray-500"><span class="font-bold">More stories:</span>
            {uncovered.map(({ st, pages }, i) => (
              <>{i > 0 ? ' · ' : ' '}<a href={`/coloring-pages/${st.id}`} class="font-bold text-[#7C3AED] hover:underline">{st.name.replace(/^The /, '')}</a> ({pages.length})</>
            ))}
          </p>
        )}

        {popular.length > 0 && (
          <section class="mt-14">
            <h2 class="font-display text-2xl font-bold text-gray-800 mb-1">Popular Memory Verses</h2>
            <p class="text-gray-500 text-sm mb-6">Verses with several coloring pages. Story passages are on each story's page.</p>
            <ul class="columns-1 sm:columns-2 lg:columns-3 gap-8 bg-white rounded-2xl border border-purple-100 p-6">
              {popular.map(([slug, v]) => (
                <li class="text-sm py-1 break-inside-avoid"><a href={`/coloring-page/${slug}`} class="text-[#7C3AED] font-bold hover:underline">{heading(v[0].promptData!).replace(/ Coloring Page$/, '')}</a>
                  <span class="text-gray-400"> · {v.length} coloring pages</span></li>
              ))}
            </ul>
          </section>
        )}
      </>
    )}
  </div>
</Base>
