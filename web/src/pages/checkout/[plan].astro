---
// /checkout/<plan>: a distraction-free payment page (no header, no footer, nothing to click away to). The order
// summary is here; the payment form is Zoho's, in an iframe (components/Checkout.tsx). Email offers arrive as
// /checkout/prints-monthly?u=<uid>&t=<token> (functions emailAction).
import Base from '../../layouts/Base.astro';
import Checkout from '../../components/Checkout.tsx';
import { CHECKOUT } from '../../lib/checkout.ts';

const plan = Astro.params.plan ?? '';
const p = Object.hasOwn(CHECKOUT, plan) ? CHECKOUT[plan] : null;
if (!p) return Astro.redirect('/pricing', 302);
Astro.cache.set(false);
Astro.response.headers.set('Cache-Control', 'no-store');
const offer = Astro.url.searchParams.get('t') || undefined;
const offerUid = Astro.url.searchParams.get('u') || undefined;
// Cloudflare's guess at the visitor's country, so the payment form doesn't start with Canadian taxes abroad.
const country = (Astro.request as Request & { cf?: { country?: string } }).cf?.country
  || Astro.request.headers.get('cf-ipcountry') || undefined;
const price = `$${p.price.toFixed(2)}`;
---
<Base title={`Checkout: ${p.name} - Bible Sketch`} robots="noindex, nofollow" bare>
  <div class="max-w-5xl mx-auto px-4 py-5 md:py-10">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2">
        <img alt="" class="w-9 h-9 object-contain" src="/logo.webp" width="36" height="36" />
        <span class="text-xl font-display font-bold text-[#1F2937]">Bible Sketch</span>
      </div>
      <span class="flex items-center gap-1.5 text-sm font-semibold text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Secure checkout
      </span>
    </div>
    <div class="grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-5 md:gap-8 items-start">
      <section class="bg-white rounded-3xl border border-purple-100 shadow-sm p-5 md:p-8 md:sticky md:top-6">
        <p class="text-sm font-bold uppercase tracking-wide text-[#7C3AED]">Your order</p>
        <h1 class="font-display text-2xl md:text-3xl font-bold text-[#1F2937] mt-1">{p.name}</h1>
        <p class="mt-2 md:mt-4 flex items-baseline gap-2">
          <span class="text-4xl font-bold text-gray-900">{price}</span>
          <span class="text-gray-500 font-medium">{p.cadence}</span>
        </p>
        {p.note && <p class="text-sm font-semibold text-emerald-700 mt-1">{p.note}</p>}
        <ul class="hidden md:block mt-6 space-y-3">{p.perks.map((perk) => <li class="flex items-start gap-3 text-gray-700"><span class="mt-0.5 p-0.5 bg-[#FCD34D] rounded-full shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-purple-900" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>{perk}</li>)}</ul>
        <!-- On a phone the payment form comes first: the perks fold away. -->
        <details class="group md:hidden mt-3">
          <summary class="cursor-pointer text-sm font-bold text-[#7C3AED] list-none">What’s included <span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span></summary>
          <ul class="mt-3 space-y-3">{p.perks.map((perk) => <li class="flex items-start gap-3 text-gray-700"><span class="mt-0.5 p-0.5 bg-[#FCD34D] rounded-full shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-purple-900" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>{perk}</li>)}</ul>
        </details>
        <p class="hidden md:block mt-6 pt-5 border-t border-gray-100 text-sm text-gray-500">Payment is processed securely by Zoho. We never see or store your card details.</p>
      </section>
      <section class="bg-white rounded-3xl border border-purple-100 shadow-sm p-2 md:p-3">
        <Checkout client:load plan={plan} offer={offer} offerUid={offerUid} country={country} />
      </section>
    </div>
    <p class="text-center text-xs text-gray-400 mt-8">
      Questions? <a href="mailto:hello@biblesketch.app" class="underline">hello@biblesketch.app</a> ·
      <a href="/terms" target="_blank" rel="noopener" class="underline">Terms</a> ·
      <a href="/privacy" target="_blank" rel="noopener" class="underline">Privacy</a>
    </p>
  </div>
</Base>
