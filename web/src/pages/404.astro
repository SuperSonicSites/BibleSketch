---
// Unknown paths the Worker answers (same links as hosting-public/404.html). Short edge cache: a page that
// appears later (a new blog post) must not stay a 404 for long.
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
Astro.response.headers.set('X-Robots-Tag', 'noindex');
Astro.response.headers.set('Cache-Control', 'public, max-age=0');
Astro.cache.set({ maxAge: 600, tags: ['pages'] });
---
<Base title="Page Not Found | Bible Sketch" robots="noindex" ogType="website">
  <div class="max-w-md mx-auto mt-20 px-4 text-center">
    <h1 class="font-display text-3xl font-bold text-gray-800 mb-2">Page Not Found</h1>
    <p class="text-gray-500 mb-8">The page you're looking for doesn't exist or has moved.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="px-6 py-3 rounded-full font-bold bg-[#7C3AED] text-white hover:bg-[#6D28D9]">Create a Coloring Page</a>
      <a href="/gallery" class="px-6 py-3 rounded-full font-bold border-2 border-[#7C3AED] text-[#7C3AED] hover:bg-purple-50">Browse the Gallery</a>
      <a href="/bible-verse-coloring" class="px-6 py-3 rounded-full font-bold border-2 border-gray-300 text-gray-700 hover:bg-gray-50">Verse Art</a>
      <a href="/blog" class="px-6 py-3 rounded-full font-bold border-2 border-gray-300 text-gray-700 hover:bg-gray-50">Blog</a>
    </div>
  </div>
</Base>
