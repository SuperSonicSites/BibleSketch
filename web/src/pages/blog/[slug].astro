---
// /blog/<slug> (bundle `Xte`): markdown rendered at build, sketch embeds read on request (live counts, and a
// sketch made private disappears). Cached at the edge with related:<id> per embed, so the onSketchWritten
// purge drops the post when one of its sketches changes. One head, rendered once (no Helmet duplicates).
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SketchEmbed from '../../components/SketchEmbed.astro';
import { getDoc } from '../../lib/firestore.ts';
import { formatDate } from '../../lib/blog.ts';
import { ORIGIN, jsonLd, type Sketch } from '../../lib/sketch.ts';

const post = Astro.params.slug ? await getEntry('blog', Astro.params.slug) : undefined;
if (!post) return Astro.rewrite('/404');
const { title, excerpt, author, date, lastmod, cover, minutes, sketchIds, segments } = post.data;
const url = `${ORIGIN}/blog/${post.id}`;
const image = `${ORIGIN}${cover.src}`;

// Embeds: one sketch read + one author read each, all in parallel. A failed or private one is left out.
const loaded = await Promise.all(sketchIds.map(async (id) => {
  const s = (await getDoc('sketches', id).catch(() => null)) as Sketch | null;
  if (!s || s.isPublic !== true || s.isBookmark) return null;
  const user = s.userId ? await getDoc('users', s.userId).catch(() => null) : null;
  return { sketch: s, author: (user?.displayName as string | undefined) || undefined };
}));
const embeds = new Map(loaded.filter((e) => e !== null).map((e) => [e!.sketch.id, e!]));

Astro.cache.set({ maxAge: 3600, swr: 86400, tags: ['blog', ...sketchIds.map((id) => `related:${id}`)] });
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

const schemas = [
  jsonLd({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: excerpt,
    image: { '@type': 'ImageObject', url: image, width: cover.width, height: cover.height },
    datePublished: date,
    dateModified: lastmod || date,
    author: { '@type': 'Person', name: author },
    publisher: { '@type': 'Organization', name: 'Bible Sketch', logo: { '@type': 'ImageObject', url: `${ORIGIN}/logo.png` } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
  }),
  jsonLd({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${ORIGIN}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${ORIGIN}/blog` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  }),
];
const share = 'flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors';
---
<Base title={`${title} - Bible Sketch Blog`} ogTitle={title} description={excerpt} canonical={url} image={image} imageAlt={title} schemas={schemas}>
  <Fragment slot="head">
    <meta property="og:image:width" content={String(cover.width)} />
    <meta property="og:image:height" content={String(cover.height)} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="article:published_time" content={date} />
    <meta property="article:modified_time" content={lastmod || date} />
    <meta property="article:author" content={author} />
  </Fragment>
  <article class="max-w-3xl mx-auto px-4 py-12 overflow-x-hidden">
    <a href="/blog" class="inline-flex items-center gap-2 text-gray-500 hover:text-gray-900 mb-8 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
      Back to all posts
    </a>
    <div class="w-full mb-12 mx-0 md:-mx-8">
      <img src={cover.src} srcset={`/img/w480${cover.src} 480w, /img/w800${cover.src} 800w, ${cover.src} ${cover.width}w`}
        sizes="(min-width: 832px) 832px, calc(100vw - 2rem)" alt={title} width={cover.width} height={cover.height} fetchpriority="high" decoding="async" class="w-full h-auto rounded-lg" />
    </div>
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 font-serif leading-tight">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-gray-500 text-sm">
        <span class="font-medium">{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
    </header>
    <div class="prose-blog blog-body prose prose-sm md:prose-lg max-w-none">
      {segments.map((s) =>
        s.type === 'html' ? <Fragment set:html={s.html} />
        : s.type === 'sketch' ? (embeds.has(s.id) && <SketchEmbed {...embeds.get(s.id)!} />)
        : (
          <div class="not-prose bg-gradient-to-br from-[#7C3AED] to-[#6D28D9] rounded-xl px-6 py-4 my-6 text-white overflow-hidden shadow-lg" data-guest-only>
            <div class="flex items-center justify-between gap-4">
              <div class="flex-1">
                <h3 class="text-lg font-display font-bold text-white mb-1">Create Free Account</h3>
                <p class="text-sm text-purple-100">Get <span class="text-[#FCD34D] font-bold">5 Free Credits</span> + High-Res Prints</p>
              </div>
              <button type="button" data-open-auth="signup" class="bg-[#FCD34D] hover:bg-[#FBBF24] text-gray-900 font-bold px-6 py-2.5 rounded-lg transition-all animate-pulseGlow whitespace-nowrap shadow-lg">Sign Up Free</button>
            </div>
          </div>
        ))}
    </div>
    <div class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex flex-wrap items-center gap-2 md:gap-4">
        <span class="text-gray-600 font-medium">Share:</span>
        <a class={share} target="_blank" rel="noopener" aria-label="Share on Twitter"
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${title} - Bible Sketch`)}&url=${encodeURIComponent(url)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          <span class="text-sm font-medium">Twitter</span>
        </a>
        <a class={share} target="_blank" rel="noopener" aria-label="Share on Facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          <span class="text-sm font-medium">Facebook</span>
        </a>
        <button type="button" class={share} data-copy={url} aria-label="Copy link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          <span class="text-sm font-medium">Copy Link</span>
        </button>
      </div>
    </div>
  </article>
</Base>
