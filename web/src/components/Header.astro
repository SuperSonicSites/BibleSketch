---
// Live nav markup (guest state) with real links. Log In / Claim Free Credits go to the SPA home, which owns
// the auth modal until the header becomes an island (rollout phase 1).
const links = [
  ['/', 'Scene Art'],
  ['/bible-verse-coloring', 'Verse Art'],
  ['/gallery', 'Gallery'],
  ['/pricing', 'Pricing'],
  ['/blog', 'Blog'],
  ['/about', 'About'],
];
---
<nav class="w-full sticky top-0 z-50 transition-all duration-300 border-b bg-[#FFF7ED]/95 backdrop-blur-md border-purple-100 py-3 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <div class="relative transition-transform duration-300 group-hover:scale-105">
        <img alt="Bible Sketch Logo" class="w-10 h-10 md:w-12 md:h-12 object-contain" src="/logo.webp" width="48" height="48" />
      </div>
      <span class="text-xl md:text-3xl font-display font-bold text-[#1F2937]">Bible Sketch</span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      {links.map(([href, label]) => (
        <a href={href} class="text-lg font-bold text-gray-500 hover:text-[#7C3AED] transition-colors">{label}</a>
      ))}
      <a href="/" class="text-lg font-bold text-gray-500 hover:text-[#7C3AED] transition-colors">Log In</a>
      <a href="/" class="inline-flex items-center justify-center rounded-full transition-all duration-200 bg-[#7C3AED] text-white hover:bg-[#6D28D9] shadow-lg shadow-purple-200 px-6 py-3 text-base font-bold gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-yellow-300 animate-wiggle" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13"></path><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"></path></svg>
        Claim Free Credits
      </a>
    </div>
    <div class="md:hidden flex items-center gap-3">
      <a href="/" class="text-base font-bold text-[#7C3AED] mr-2">Log In</a>
      <details class="relative">
        <summary class="list-none text-gray-700 p-1 hover:bg-gray-100 rounded-lg transition-colors cursor-pointer" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg>
        </summary>
        <div class="absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-purple-100 py-2">
          {links.map(([href, label]) => (
            <a href={href} class="block px-5 py-3 text-lg font-bold text-gray-600 hover:text-[#7C3AED] hover:bg-purple-50">{label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</nav>
