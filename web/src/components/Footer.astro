---
// Live footer markup, with real links (the bundle used navigate() buttons) and an About link.
---
<footer class="bg-[#FFF7ED] border-t border-purple-50 py-12 mt-12">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <p class="text-gray-600 text-sm mb-4">© {new Date().getUTCFullYear()} Bible Sketch. All rights reserved.</p>
    <div class="flex justify-center gap-6">
      <a href="/about" class="text-gray-600 hover:text-[#7C3AED] text-sm font-medium transition-colors">About</a>
      <a href="/terms" class="text-gray-600 hover:text-[#7C3AED] text-sm font-medium transition-colors">Terms of Service</a>
      <a href="/privacy" class="text-gray-600 hover:text-[#7C3AED] text-sm font-medium transition-colors">Privacy Policy</a>
    </div>
  </div>
</footer>
