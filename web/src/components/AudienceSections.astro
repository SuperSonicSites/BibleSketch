---
// Collection pages grouped by audience (docs/seo-plan.md stage 9): toddler, children, teen and adult scene art and
// verse art each get their own section, in Bible order, so every section reads in one style. A row of buttons
// jumps to each section; it scrolls sideways on phones instead of wrapping, and stays under the site header.
// Everything is plain HTML and links: no script, no separate URLs per audience.
import ListingCard from './ListingCard.astro';
import CardIcons from './CardIcons.astro';
import { type Sketch } from '../lib/sketch.ts';
import { byBibleOrder } from '../lib/stories.ts';

interface Props { pages: Sketch[]; authors: Map<string, string>; idPrefix?: string }
const { pages, authors, idPrefix = 'for' } = Astro.props;

const GROUPS = [
  { key: 'Toddler', label: 'Toddlers', blurb: 'Big shapes and bold lines for little hands.' },
  { key: 'Young Child', label: 'Young Children', blurb: 'Simple scenes with a little more to color.' },
  { key: 'Teen', label: 'Teens', blurb: 'More detail for older kids and youth groups.' },
  { key: 'Adult', label: 'Adults', blurb: 'Detailed art for adults and Bible journaling.' },
  { key: 'verse', label: 'Verse Art', blurb: 'The words of the passage, lettered to color.' },
];
const keyOf = (s: Sketch) => (s.type === 'verse' ? 'verse' : s.promptData?.age_group === 'Pre-Teen' ? 'Teen' : s.promptData?.age_group ?? 'Adult');
const sections = GROUPS.map((g) => ({ ...g, id: `${idPrefix}-${g.label.toLowerCase().replace(/\s+/g, '-')}`, items: pages.filter((s) => keyOf(s) === g.key).sort(byBibleOrder) }))
  .filter((g) => g.items.length);
---
<CardIcons />
{sections.length > 1 && (
  <nav aria-label="Coloring pages by age" class="sticky top-[4.4rem] md:top-[4.8rem] z-40 -mx-4 px-4 py-3 mb-6 bg-[#FFF7ED]/95 backdrop-blur-md border-b border-purple-100">
    <ul class="flex gap-2 overflow-x-auto whitespace-nowrap [scrollbar-width:none]">
      {sections.map((g) => (
        <li><a href={`#${g.id}`} class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-bold bg-white border border-purple-200 text-[#7C3AED] hover:bg-purple-50 transition-colors">
          {g.label}<span class="text-xs font-semibold text-gray-400">{g.items.length}</span>
        </a></li>
      ))}
    </ul>
  </nav>
)}
<div class="space-y-14">
  {sections.map((g) => (
    <section id={g.id} class="scroll-mt-36">
      <div class="mb-4">
        <h2 class="font-display text-2xl font-bold text-gray-800">{g.key === 'verse' ? g.label : `For ${g.label}`} <span class="text-base font-semibold text-gray-400">({g.items.length})</span></h2>
        <p class="text-gray-500 text-sm">{g.blurb}</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {g.items.map((s) => <ListingCard sketch={s} author={s.userId ? authors.get(s.userId) : undefined} compact />)}
      </div>
    </section>
  ))}
</div>
