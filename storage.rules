rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // User uploads - only the owner can read/list/write, images up to 15 MB
    match /user_uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null
                       || (request.resource.size < 15 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }

    // Anyone may fetch a sketch image by its exact path (thumbnails, sharing),
    // but not list another user's folder.
    match /user_uploads/{userId}/sketches/{allPaths=**} {
      allow get: if true;
    }
  }
}
